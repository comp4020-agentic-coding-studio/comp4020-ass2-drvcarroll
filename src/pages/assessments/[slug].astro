---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import Callout from "astro-theme-university/components/Callout.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import MarkingModel from "../../components/MarkingModel.astro";
import { formatCourseDate } from "../../lib/dates";
import { graphCollections, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const assessments = await getPublishedCollection("assessments");
  return assessments.map((assessment) => ({
    params: { slug: assessment.id },
    props: { assessment },
  }));
}

const { assessment } = Astro.props;
const { data } = assessment;
const { Content } = await render(assessment);
---

<ContentLayout
  title={data.title}
  description={data.description}
  heroImage={data.heroImage}
  heroImageAlt={data.heroImageAlt}
  {...siteConfig}
>
  <PageLayout>
    {
      data.draft && (
        <Callout type="warning">
          <p>
            <strong>Draft.</strong> This brief is still being finalised and
            may change.
          </p>
        </Callout>
      )
    }

    <section aria-labelledby="the-brief">
      <h2 id="the-brief">The brief</h2>
      <blockquote>
        <p>{data.brief}</p>
      </blockquote>
      <Content />
      {
        data.exemplars && data.exemplars.length > 0 && (
          <ul>
            {data.exemplars.map((exemplar) => (
              <li>
                <a href={exemplar.url}>{exemplar.title}</a> — {exemplar.description}
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {
      data.submissionItems && data.submissionItems.length > 0 && (
        <section aria-labelledby="what-you-submit">
          <h2 id="what-you-submit">What you submit</h2>
          <ul>
            {data.submissionItems.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )
    }

    <p>
      <strong>Due:</strong> {formatCourseDate(data.due)} ·
      <strong>Weight:</strong> {data.weight}% of the course grade
    </p>
    {data.marking && <MarkingModel marking={data.marking} />}

    {
      data.keyDates && data.keyDates.length > 0 && (
        <section aria-labelledby="key-dates">
          <h2 id="key-dates">Key dates</h2>
          <ul>
            {data.keyDates.map((keyDate) => (
              <li>
                <strong>{keyDate.label}:</strong> {formatCourseDate(keyDate.date)}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <SpecList spec={data.spec}>
      The brief poses the problem and leaves room for a response. The spec is
      the fixed part: what a marker checks. Some lines can be checked
      mechanically; the rest call for judgement.
    </SpecList>
    <RelatedContent entry={assessment} collections={graphCollections} />
  </PageLayout>
</ContentLayout>
