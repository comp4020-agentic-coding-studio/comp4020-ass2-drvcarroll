---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import PageLayout from "../layouts/PageLayout.astro";
import heroImage from "../assets/images/overview_background.jpg";
import { courseMeta } from "../course-config";
import { siteConfig } from "../site-config";
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="A black background filled with cascading columns of green digital-rain characters — Latin letters, digits and Japanese kana and kanji, a few glowing bright white"
  {...siteConfig}
>
  <PageLayout>
    <ul class="course-tags" aria-label="Course tags">
      {courseMeta.tags.map((tag) => <li>{tag}</li>)}
    </ul>

    <!-- STARTER_CONTENT: replace the authored page below, then remove this comment. -->
    <h2>What you will do</h2>
    <p>
      Say what a student spends their time on — the making, reading, arguing
      or measuring that fills the weeks. Name the artefact they walk out
      with.
    </p>

    <h2>Who it is for</h2>
    <p>
      Say who this is aimed at and what they need to already know. Be
      specific enough that someone can rule themselves in or out without
      emailing you.
    </p>

    <h2>Where to go next</h2>
    <CardGrid columns={2}>
      <Card title="Timeline" href={withBase("/timeline/")}>
        <p>Every graded deliverable, in semester order, on one spine.</p>
      </Card>
      <Card title="People" href={withBase("/people/")}>
        <p>Who teaches the course and how to reach them.</p>
      </Card>
      <Card title="Policies" href={withBase("/policies/")}>
        <p>The rules that govern how the course is run and assessed.</p>
      </Card>
    </CardGrid>
  </PageLayout>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
