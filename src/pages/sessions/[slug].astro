---
import { getEntry } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import Card from "astro-theme-university/components/Card.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import PageLayout from "../../layouts/PageLayout.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import { formatCourseDate } from "../../lib/dates";
import { graphCollections, sessionLabels, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const sessions = await getPublishedCollection("sessions");
  return sessions.map((session) => ({ params: { slug: session.id }, props: { session } }));
}

const { session } = Astro.props;
const lecture = await getEntry(session.data.lecture);
// Absent on Weeks 1 and 12 (D22): ten labs cover Weeks 2-11 only.
const lab = session.data.lab ? await getEntry(session.data.lab) : undefined;
const assignment = session.data.assignment ? await getEntry(session.data.assignment) : undefined;

// Section number from the entry's own id (D28), not week number:
// lab/assignment numbering doesn't run 1:1 with week (D22).
function entryNumber(id: string): number {
  return Number(id.match(/\d+$/)?.[0]);
}

// Per-section subtitle, referenced entry and its page path (D15).
const sections = [
  {
    subtitle: `Lecture ${session.data.week}`,
    entry: lecture,
    href: withBase(`/lectures/${lecture.id}/`),
  },
  ...(lab
    ? [
        {
          subtitle: `Lab ${entryNumber(lab.id)}`,
          entry: lab,
          href: withBase(`/assessments/${lab.id}/`),
        },
      ]
    : []),
  ...(assignment
    ? [
        {
          subtitle: `Assignment ${entryNumber(assignment.id)}`,
          entry: assignment,
          href: withBase(`/assessments/${assignment.id}/`),
        },
      ]
    : []),
];
---

<ContentLayout
  title={`Week ${session.data.week} ${sessionLabels.singular}: ${session.data.title}`}
  description={session.data.description}
  {...siteConfig}
>
  <PageLayout>
    <p><strong>{formatCourseDate(session.data.date)}</strong></p>
    <div class="session-sections">
      {
        sections.map(({ subtitle, entry, href }) => (
          <div class="session-section">
            <h2>{subtitle}</h2>
            <Card headingLevel="h3" title={entry.data.title} href={href}>
              <p>{entry.data.description}</p>
            </Card>
          </div>
        ))
      }
    </div>
    <TeachingTeam teachers={session.data.teachers} />
    <RelatedContent entry={session} collections={graphCollections} />
  </PageLayout>
</ContentLayout>

<style is:global>
  /* One section (subtitle, card) stacks per unit; units stack in a
     single column (D19), not two side-by-side CardGrids. */
  .session-sections {
    display: flex;
    flex-direction: column;
    gap: var(--at-spacing-lg);
  }

  /* Tighten the default h1/p.lead spacing on session pages only, matched by
     the presence of .session-sections so no other page is affected. */
  #main:has(.session-sections) > h1 {
    margin-block-start: var(--at-spacing-md);
  }

  #main:has(.session-sections) > p.lead {
    margin-block-end: var(--at-spacing-md);
  }
</style>
