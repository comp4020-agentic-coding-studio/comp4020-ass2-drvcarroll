---
import { getEntry } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import { formatCourseDate } from "../../lib/dates";
import { graphCollections, sessionLabels, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const sessions = await getPublishedCollection("sessions");
  return sessions.map((session) => ({ params: { slug: session.id }, props: { session } }));
}

const { session } = Astro.props;
const lecture = await getEntry(session.data.lecture);
const lab = await getEntry(session.data.lab);
const assignment = session.data.assignment ? await getEntry(session.data.assignment) : undefined;
---

<ContentLayout
  title={`Week ${session.data.week} ${sessionLabels.singular}: ${session.data.title}`}
  description={session.data.description}
  {...siteConfig}
>
  <PageLayout>
    <p><strong>{formatCourseDate(session.data.date)}</strong></p>
    <CardGrid columns={assignment ? 3 : 2}>
      <Card headingLevel="h2" title={`Lecture ${session.data.week}`} href={`/lectures/${lecture.id}/`}>
        {lecture.data.description}
      </Card>
      <Card headingLevel="h2" title={`Lab ${session.data.week}`} href={`/assessments/${lab.id}/`}>
        {lab.data.description}
      </Card>
      {
        assignment && (
          <Card headingLevel="h2" title={assignment.data.title} href={`/assessments/${assignment.id}/`}>
            {assignment.data.description}
          </Card>
        )
      }
    </CardGrid>
    <TeachingTeam teachers={session.data.teachers} />
    <RelatedContent entry={session} collections={graphCollections} />
  </PageLayout>
</ContentLayout>
