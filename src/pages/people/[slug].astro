---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import heroImage from "../../assets/images/people_background.jpg";
import { siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const people = await getPublishedCollection("people");
  return people.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

const { person } = Astro.props;
const { Content } = await render(person);

// Map the role enum (convenor|tutor|guest|other) to display labels rather than
// rendering the raw lowercase value.
const roleLabels: Record<string, string> = {
  convenor: "Convenor",
  tutor: "Tutor",
  guest: "Guest lecturer",
  other: "",
};
// Falls back to the raw value for a role outside the four-value enum (e.g.
// Step 21's "Course Convenor"/"Co-Convenor"), rather than hiding the row.
const roleLabel = person.data.role
  ? (roleLabels[person.data.role] ?? person.data.role)
  : undefined;
// Every page owes a description --- it is what a search result and a shared
// link show underneath the title.
const description = person.data.description;
---

<ContentLayout
  title={person.data.title}
  description={description}
  heroImage={heroImage}
  heroImageAlt="A black background filled with dense cascading columns of green alphanumeric code-rain characters"
  {...siteConfig}
>
  <PageLayout>
    <dl>
      {roleLabel && (
        <>
          <dt>Role</dt>
          <dd>{roleLabel}</dd>
        </>
      )}
      {person.data.affiliation && (
        <>
          <dt>Affiliation</dt>
          <dd>{person.data.affiliation}</dd>
        </>
      )}
      {person.data.email && (
        <>
          <dt>Email</dt>
          <dd>
            <a href={`mailto:${person.data.email}`}>{person.data.email}</a>
          </dd>
        </>
      )}
      {person.data.url && (
        <>
          <dt>Web</dt>
          <dd>
            <a href={person.data.url}>{person.data.url}</a>
          </dd>
        </>
      )}
      <dt>Contact</dt>
      <dd>{person.data.contact}</dd>
    </dl>

    <Content />
  </PageLayout>
</ContentLayout>

<style>
  /* Row-pairs dt/dd regardless of how many are conditionally rendered */
  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.5rem 0;
  }

  dt,
  dd {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0.5rem 0.75rem;
    /* Fixed dark chip: legible in both light/dark theme states */
    background: #1a1a1a;
  }

  dt {
    color: #eab308;
    font-weight: 600;
    border-radius: var(--at-border-radius) 0 0 var(--at-border-radius);
  }

  dd {
    color: var(--at-white);
    border-radius: 0 var(--at-border-radius) var(--at-border-radius) 0;
  }

  dd a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
  }
</style>
