---
// One graded deliverable: a circle on the spine, then title, date and
// description. Never computes its own position or formats its own data;
// the spine (TimelineSpine.astro) supplies order, formatting, and copy.
export interface Props {
  label: string;
  href: string;
  date: string;
  description: string;
}

const { label, href, date, description } = Astro.props;
---

<li class="timeline-bead">
  <a href={href}>
    <span class="timeline-bead-dot" aria-hidden="true"></span>
    <span class="timeline-bead-label">{label}</span>
    <span class="timeline-bead-date">{date}</span>
    <span class="timeline-bead-description">{description}</span>
  </a>
</li>
