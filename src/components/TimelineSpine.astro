---
// The Timeline page's beaded rule. Reads the assessments collection,
// orders it with the pure `orderBeads` (src/lib/timeline.ts), and renders
// one TimelineBead per entry along a thickened vertical line.
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import TimelineBead from "./TimelineBead.astro";
import { orderBeads } from "../lib/timeline";
import { formatCourseDate } from "../lib/dates";
import "../styles/timeline.css";

const assessments = await getPublishedCollection("assessments");
const beads = orderBeads(assessments);
---

<ol class="timeline-spine">
  {
    beads.map((entry) => (
      <TimelineBead
        label={entry.data.title}
        href={withBase(`/assessments/${entry.id}/`)}
        date={formatCourseDate(entry.data.due)}
        description={entry.data.description ?? ""}
      />
    ))
  }
</ol>
