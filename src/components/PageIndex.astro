---
// Right rail's content: an index of the current page's own headings, built
// client-side from the rendered DOM (BUILD_PLAN.md D4). Reads #main h2/h3
// only, never a collection, so it renders identically on every page type
// with no per-page wiring.
---

<nav class="page-index" aria-label="On this page"></nav>

<script>
  import { buildPageIndex, type PageIndexEntry } from "../lib/page-index";

  // A heading with no id (rehype-slug never touched it) has nothing to
  // anchor to — inert text, same convention as WeekRail's missing-week row.
  function renderEntry(entry: PageIndexEntry): HTMLLIElement {
    const li = document.createElement("li");
    li.className = `page-index-level-${entry.level}`;
    const target = document.createElement(entry.id ? "a" : "span");
    if (entry.id) target.setAttribute("href", `#${entry.id}`);
    target.textContent = entry.text;
    li.append(target);
    return li;
  }

  // Re-run on every soft navigation: the DOM's headings have changed, so
  // the index must be rebuilt rather than left showing the old page's.
  function setupPageIndex(): void {
    const nav = document.querySelector<HTMLElement>(".page-index");
    if (!nav) return;
    nav.replaceChildren();
    const entries = buildPageIndex(document);
    if (entries.length === 0) {
      const empty = document.createElement("p");
      empty.className = "page-index-empty";
      empty.textContent = "No sections on this page";
      nav.append(empty);
    } else {
      const list = document.createElement("ul");
      list.append(...entries.map(renderEntry));
      nav.append(list);
    }
  }

  document.addEventListener("astro:page-load", setupPageIndex);
</script>

<style is:global>
  /* Global: the list/items below are created client-side (script above),
     so they never carry the data-astro-cid- scoping attribute a normal
     scoped <style> here relies on to match. */
  .page-index ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .page-index li {
    padding: 0.25rem 0.5rem;
  }

  .page-index-level-3 {
    margin-inline-start: 0.75rem;
  }

  .page-index a,
  .page-index span {
    color: inherit;
    text-decoration: none;
    overflow-wrap: break-word;
  }

  .page-index a:hover,
  .page-index a:focus-visible {
    text-decoration: underline;
  }

  /* Missing id: inert text, visually recessed rather than a dead link. */
  .page-index span {
    color: var(--at-text-muted);
  }

  .page-index-empty {
    margin: 0;
    padding: 0.25rem 0.5rem;
    color: var(--at-text-muted);
    font-style: italic;
  }
</style>
