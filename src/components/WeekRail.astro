---
// Left rail's content: 12 rows (Weeks 1-12), rendered inside GutterRail's
// slot. Reads only the sessions collection and the current path — never the
// page it is mounted on (BUILD_PLAN.md section 2).
// Exam period lives only on the Timeline (D12), not here.
import { getPublishedCollection } from "astro-course-university/content";
import { buildWeekRows } from "../lib/weeks";

export interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const sessions = await getPublishedCollection("sessions");

const rows = buildWeekRows(
  sessions.map((session) => ({ week: session.data.week, id: session.id })),
  currentPath,
);
---

<ul class="week-rail">
  {
    rows.map((row) => (
      <li aria-current={row.current ? "page" : undefined}>
        {row.href ? <a href={row.href}>{row.label}</a> : <span>{row.label}</span>}
      </li>
    ))
  }
</ul>

<style>
  .week-rail {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .week-rail li {
    padding: 0.25rem 0.5rem;
    border-left: 2px solid transparent;
    overflow-wrap: break-word;
  }

  .week-rail a,
  .week-rail span {
    color: inherit;
    text-decoration: none;
  }

  .week-rail a:hover,
  .week-rail a:focus-visible {
    text-decoration: underline;
  }

  /* Missing week: inert text, visually recessed rather than a dead link. */
  .week-rail span {
    color: var(--at-text-muted);
  }

  /* Current week: border + weight + marker, never colour alone. */
  .week-rail li[aria-current="page"] {
    border-left-color: var(--at-accent);
    font-weight: 700;
  }

  .week-rail li[aria-current="page"]::before {
    content: "→ ";
  }
</style>
