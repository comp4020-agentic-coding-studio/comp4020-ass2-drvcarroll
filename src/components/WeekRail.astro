---
// Left rail's content: 13 rows (Weeks 1-12 + Exam), rendered inside
// GutterRail's slot. Reads only the sessions/assessments collections and
// the current path — never the page it is mounted on (BUILD_PLAN.md
// section 2).
import { getPublishedCollection } from "astro-course-university/content";
import { buildWeekRows } from "../lib/weeks";

export interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const sessions = await getPublishedCollection("sessions");
const assessments = await getPublishedCollection("assessments");

// No "final exam" entry exists yet (Step 6 adds one) — matched by id or
// title so this keeps working once it lands, without guessing its slug.
const examEntry = assessments.find(
  (entry) => entry.id === "final-exam" || /exam/i.test(entry.data.title),
);
const examHref = examEntry ? `/assessments/${examEntry.id}/` : null;

const rows = buildWeekRows(
  sessions.map((session) => ({ week: session.data.week, id: session.id })),
  currentPath,
  examHref,
);
---

<ul class="week-rail">
  {
    rows.map((row) => (
      <li
        class={row.week === "exam" ? "week-rail-exam" : undefined}
        aria-current={row.current ? "page" : undefined}
      >
        {row.href ? <a href={row.href}>{row.label}</a> : <span>{row.label}</span>}
      </li>
    ))
  }
</ul>

<style>
  .week-rail {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .week-rail li {
    padding: 0.25rem 0.5rem;
    border-left: 2px solid transparent;
    overflow-wrap: break-word;
  }

  .week-rail a,
  .week-rail span {
    color: inherit;
    text-decoration: none;
  }

  .week-rail a:hover,
  .week-rail a:focus-visible {
    text-decoration: underline;
  }

  /* Missing week: inert text, visually recessed rather than a dead link. */
  .week-rail span {
    color: var(--at-text-muted);
  }

  /* Current week: border + weight + marker, never colour alone. */
  .week-rail li[aria-current="page"] {
    border-left-color: var(--at-accent);
    font-weight: 700;
  }

  .week-rail li[aria-current="page"]::before {
    content: "→ ";
  }

  /* Exam row: ruled off from the 12 week rows, always last. */
  .week-rail-exam {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--at-divider);
    font-style: italic;
  }
</style>
